# Supabase — mesmo projeto usado pelo ETL (ajxmbhfmitehmxvjkcdk)
NEXT_PUBLIC_SUPABASE_URL=https://ajxmbhfmitehmxvjkcdk.supabase.co
# Settings -> API -> Project API keys -> anon / public
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Settings -> API -> Project API keys -> service_role (secret, só server-side)
SUPABASE_SERVICE_ROLE_KEY=

# Google Cloud Console -> APIs & Services -> Credentials (módulo de prospecção de leads)
# Chave restrita à Places API (New), só server-side — usada em src/app/api/prospeccao/buscar
GOOGLE_PLACES_API_KEY=
# Chave restrita à Maps JavaScript API, com HTTP referrers configurados (é pública, vai
# pro navegador) — usada em src/components/prospeccao/mapa-prospeccao.tsx
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# App do Bling (mesmo do ETL) — só server-side, usado pela Conferência de Preços pra alterar
# preço via API. Os tokens OAuth vêm de public.bling_oauth (compartilhados com o ETL).
BLING_CLIENT_ID=
BLING_CLIENT_SECRET=
BLING_CONTA=barbers
