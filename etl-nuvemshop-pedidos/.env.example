# ============================================================================
# etl-nuvemshop-pedidos — variáveis de ambiente (execução local)
# Copie para .env e preencha. NUNCA versione o .env.
# ============================================================================
LOCAL_MODE=true

# Supabase (project ref ajxmbhfmitehmxvjkcdk) — precisa ser a chave service_role
SUPABASE_URL=https://ajxmbhfmitehmxvjkcdk.supabase.co
SUPABASE_SERVICE_KEY=

# Os tokens das lojas NÃO ficam aqui: vêm de public.canais_integracoes (lojas conectadas pelo
# módulo Canais de Venda do dashboard). Sem loja conectada, o ETL só avisa e termina.

DISCORD_WEBHOOK_URL=

ETL_CLIENTE=barbers
LOCAL_CLIENT_CONFIGS={"barbers":{"schema":"barbers"}}
# Recarrega pedidos ALTERADOS nas últimas N horas (padrão 24). Pedido novo também conta como alterado.
ETL_ALTERADOS_HORAS=24
# Backfill: recarrega tudo que mudou desde esta data (AAAA-MM-DD). Tem prioridade sobre ETL_ALTERADOS_HORAS.
ETL_DATA_INICIAL=
