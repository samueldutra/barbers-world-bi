# ============================================================================
# etl-shopee-pedidos — variáveis de ambiente (execução local)
# Copie para .env e preencha. NUNCA versione o .env.
# ============================================================================
LOCAL_MODE=true

# Supabase — precisa ser a chave service_role
SUPABASE_URL=https://ajxmbhfmitehmxvjkcdk.supabase.co
SUPABASE_SERVICE_KEY=

# App Shopee padrão (usado quando o cliente não tem linha 'shopee' em public.canais_apps). partner_key de PRODUÇÃO.
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
# Host da API (padrão: produção Brasil). Sandbox: https://openplatform.sandbox.test-stable.shopee.sg
SHOPEE_API_HOST=https://openplatform.shopee.com.br

DISCORD_WEBHOOK_URL=

ETL_CLIENTE=invento3d
# Formato: {"slug":{"schema":"...","tenant_id":"<public.tenants.id>"}} (tenant_id obrigatório). No GitHub Actions é
# montado a partir de public.tenants.
LOCAL_CLIENT_CONFIGS={"invento3d":{"schema":"invento3d","tenant_id":""}}
# Recarrega pedidos ALTERADOS nas últimas N horas (padrão 24).
ETL_ALTERADOS_HORAS=24
# Backfill: recarrega tudo que mudou desde esta data (AAAA-MM-DD). Tem prioridade sobre ETL_ALTERADOS_HORAS.
ETL_DATA_INICIAL=
