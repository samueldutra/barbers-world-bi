# ============================================================================
# etl-mercadolivre-pedidos — variáveis de ambiente (execução local)
# Copie para .env e preencha. NUNCA versione o .env.
# ============================================================================
LOCAL_MODE=true

# Supabase (project ref ajxmbhfmitehmxvjkcdk) — precisa ser a chave service_role
SUPABASE_URL=https://ajxmbhfmitehmxvjkcdk.supabase.co
SUPABASE_SERVICE_KEY=

# App do Mercado Livre (DevCenter) — o mesmo do dashboard. Necessário para RENOVAR o access_token (vale 6 h).
# Os tokens das contas NÃO ficam aqui: vêm de public.canais_integracoes (Canais de Venda).
MERCADOLIVRE_APP_ID=
MERCADOLIVRE_CLIENT_SECRET=

DISCORD_WEBHOOK_URL=

ETL_CLIENTE=barbers
# Formato: {"slug":{"schema":"...","conta_bling":"...","tenant_id":"<public.tenants.id>"}} (tenant_id obrigatório nos ETLs de
# Nuvemshop/Mercado Livre). No GitHub Actions é montado a partir de public.tenants.
LOCAL_CLIENT_CONFIGS={"barbers":{"schema":"barbers"}}
# Recarrega pedidos ALTERADOS nas últimas N horas (padrão 24). Pedido novo também conta como alterado.
ETL_ALTERADOS_HORAS=24
# Backfill: recarrega tudo que mudou desde esta data (AAAA-MM-DD). Tem prioridade sobre ETL_ALTERADOS_HORAS.
ETL_DATA_INICIAL=
