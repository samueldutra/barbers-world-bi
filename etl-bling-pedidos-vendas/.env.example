# ============================================================================
# etl-bling-pedidos-vendas — variáveis de ambiente (execução local)
# Copie para .env e preencha. NUNCA versione o .env.
# ============================================================================

# --- Modo ---
LOCAL_MODE=true

# --- Supabase ---
# Project ref: ajxmbhfmitehmxvjkcdk
SUPABASE_URL=https://ajxmbhfmitehmxvjkcdk.supabase.co
# Settings -> API -> Project API keys -> service_role (secret). NÃO é a anon key.
SUPABASE_SERVICE_KEY=

# --- Bling API v3 (app criado em https://developer.bling.com.br) ---
BLING_CLIENT_ID=
BLING_CLIENT_SECRET=
# Precisa ser EXATAMENTE a URL de redirecionamento cadastrada no app do Bling.
BLING_REDIRECT_URI=http://localhost:8080/callback

# Fonte de verdade dos tokens OAuth: tabela public.bling_oauth no Supabase.
# O bootstrap grava lá; o ETL lê, renova (refresh) e regrava automaticamente.
# Identificador da linha de tokens (1 por conta Bling).
BLING_CONTA=barbers

# --- Discord (opcional — notificação de execução) ---
DISCORD_WEBHOOK_URL=

# --- Parâmetros da execução local ---
ETL_CLIENTE=barbers
# JSON: mapeia cliente -> schema no Supabase + conta usada em public.bling_oauth
LOCAL_CLIENT_CONFIGS={"barbers":{"schema":"barbers","conta_bling":"barbers"}}
# Data inicial do backfill (primeira carga histórica). Ajuste conforme necessário.
ETL_DATA_INICIAL=2024-01-01
# Vazio = hoje
ETL_DATA_FINAL=
